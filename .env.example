# Compose loads .env. Source execution reads exported variables and KHS_CONFIG.
# Generate independent random values, for example: openssl rand -hex 32
SERVICE_API_TOKEN=
POSTGRES_PASSWORD=
KIRO_API_KEY=
KHS_ENGINE=kiro
KHS_CLI_BOOTSTRAP=download
# The image pins the CLI release. It is downloaded on the deployer's machine and cached.
# For a preloaded CLI cache use compose.offline.yaml and KHS_CLI_CACHE_HOST_DIR.
# KHS_CLI_CACHE_HOST_DIR=/absolute/path/to/runtime-cache
# Optional proxy for downloads; explicitly authorize proxy variables for Kiro subprocesses:
# HTTPS_PROXY=http://proxy.example.internal:8080
# KHS_KIRO_PROXY_ENV_REFS={"HTTPS_PROXY":"env:HTTPS_PROXY","NO_PROXY":"env:NO_PROXY"}
# Set this to your CI-produced deployment image tag/digest. Use :local after a local build.
KHS_IMAGE=kiro-headless-service:local
# User-owned files/directories on the host; no service source edits required.
KHS_CONFIG_FILE=./examples/service.json
KHS_KIRO_CONFIG_HOST_DIR=./examples/kiro
# For account-free tests only: KHS_ENGINE=simulated
# Version 2.37.1 and engine V3 come from the image release, not this file.
# External PostgreSQL example:
# KHS_DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/kiro?sslmode=verify-full
